# === MDPL Bill of Lading Extractor — Example Configuration (v2.1) ===
# Copy to .env and adjust. Values here ARE the code defaults — keep them in sync.
# The model server (llama-server) is ALREADY RUNNING on the DGX — we only
# connect to it. Do NOT start/stop the model from these scripts.
#
# The shared server is provisioned by Proof-Reader's startserver.sh (see the
# README). This project only needs CONTEXT_SIZE and MODEL_PARALLEL to match it,
# so the client-side context guard and /healthz budget cross-check are correct.

# === Model Server (llama.cpp with CUDA) — pre-existing, already running ===
# URL of the running OpenAI-compatible chat endpoint.
MODEL_URL="http://127.0.0.1:8006/v1/chat/completions"
MODEL_NAME="Qwen3.8-27B"

# --- Context budget (MUST MATCH the shared server's launch flags) ---
# llama.cpp divides its total --ctx-size across --parallel slots. These values
# must equal the shared server's so the per-slot budget (CONTEXT_SIZE //
# MODEL_PARALLEL) matches what the server actually serves.
#
#   Profile           CONTEXT_SIZE   MODEL_PARALLEL   Per-slot
#   Conservative      32768          4                8192
#   Balanced          65536          4                16384  (default)
#   Maximum           131072         2                65536  (VERIFY memory first)
#
# B/L allocation per the context-sizing plan: 16k per slot (Balanced).
CONTEXT_SIZE="65536"
MODEL_PARALLEL="4"

# --- Output tokens ---
# A B/L extraction emits one compact JSON object (~300-500 tokens); 4096 is
# generous headroom against truncation mid-JSON. Raising it reduces the local
# prompt-room budget (slot − max_tokens − 256).
MODEL_MAX_TOKENS="4096"

# Internal bearer token the FastAPI gateway presents to the shared llama-server.
# Sent ONLY if non-empty. MUST MATCH the shared server's --api-key, or the server
# rejects the call with a 401 (the gateway then returns a 503 on every extract).
# The shared server is started by Proof-Reader's startserver.sh with
# --api-key sk-internal-proofreader, so the default matches it.
LLAMA_SERVER_API_KEY="sk-internal-proofreader"

# Sampling (forwarded to the server; all .env-tunable).
# TEMP=0.0 (greedy) yields deterministic extraction run-to-run on factual
# document parsing.
MODEL_TEMP="0.0"
MODEL_TOP_P="0.5"
MODEL_TOP_K="40"

# The model is a thinking model. DISABLE_THINKING=1 still sends
# reasoning_effort=0 and chat_template_kwargs{enable_thinking:false} (best-effort,
# with a degradation/retry chain). extract_json() strips any leaked thinking.
DISABLE_THINKING="1"

# Request timeout to the model server, in seconds. Batch requests multiply this
# per entry.
REQUEST_TIMEOUT="300"

# Client-side context guard: strict (default, 422 with guidance), warn (allow +
# log), or off (testing only).
CONTEXT_GUARD="strict"

# === Registered customer table (config-driven; D3 decision) ===
# JSON array of {Code, Buyer, RegisteredCustomerName} rows. Leave empty ("")
# to use the built-in defaults from the v2.1 spec (C0002/C0003/C0005/C0006).
# Matching is case/punctuation/bracket-insensitive: exact normalized
# RegisteredCustomerName -> exact normalized Buyer -> substring containment.
# No match or ambiguous match => CustomerCode "N/A" (CustomerName kept verbatim).
CUSTOMER_TABLE=""

# === MDPL Bill of Lading Extractor API Service ===
# Deliberately 8086 — 8082 is Proof-Reader dev, 8085 is Proof-Reader PROD
# (moved off 8082 due to a port conflict), 8083 QA-Manager, 8084 GDS-Extraction.
API_PORT="8086"
API_HOST="0.0.0.0"
API_KEY_AUTH_HEADER="x-api-key"

# === API Keys (comma-separated list of keys) ===
# Any of these values is accepted as a valid client key. Replace with your own secrets.
API_KEYS="bol_key_0000:BOL Extraction Local Testing"
